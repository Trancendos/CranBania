# CranBania — The Town Hall (Trancendos platform, Lead AI: Tristuran)
#
# Copy to `.env.local` for development, or supply these as container environment
# variables in production. Every variable the application actually reads is listed
# here; nothing else is consulted at runtime.
#
# Production note: CRANBANIA_API_KEY is REQUIRED. With it unset, mutating API routes
# fail closed with 503 (see middleware.ts) and docker-compose.production.yml refuses
# to start the service at all. Read/GET routes remain ungated regardless — they are
# protected by a network boundary in front of the service, not by this key. See
# docs/security-advisories.md.

# ── Auth ────────────────────────────────────────────────────────────────────────
# Shared secret gating all mutating (POST/PUT/PATCH/DELETE) /api routes.
# Generate with: openssl rand -hex 32
CRANBANIA_API_KEY=

# Separate secret for the SLA cron endpoint (POST /api/itsm/sla/check), which is
# exempt from CRANBANIA_API_KEY because schedulers authenticate with this instead.
# Generate with: openssl rand -hex 32
CRANBANIA_CRON_SECRET=

# ── SLA monitoring ──────────────────────────────────────────────────────────────
# Poll interval for the sidecar SLA poller (`npm run sla:poll`), milliseconds.
CRANBANIA_SLA_POLL_INTERVAL_MS=60000

# Percentage of an SLA window consumed before a warning webhook fires (0-100).
CRANBANIA_SLA_WARNING_PERCENT=80

# ── Webhooks ────────────────────────────────────────────────────────────────────
# Single outbound webhook target for card events (sla_breach, transitions).
CRANBANIA_WEBHOOK_URL=

# Comma-separated list of webhook targets. Takes precedence over the singular form
# above when both are set.
CRANBANIA_WEBHOOK_URLS=

# ── Forgejo integration (The Workshop) ──────────────────────────────────────────
# Base URL of the Forgejo instance used for workflow dispatch.
FORGEJO_URL=http://forgejo:3000

# Access token with workflow-dispatch permission on the repo below.
FORGEJO_TOKEN=

# Repository coordinates for dispatched workflows.
FORGEJO_OWNER=Trancendos
FORGEJO_REPO=Tranc3
FORGEJO_REF=main

# Workflow filenames dispatched on card state changes.
FORGEJO_WORKFLOW_IN_PROGRESS=cranbania-in-progress.yml
FORGEJO_WORKFLOW_SLA_BREACH=cranbania-sla-check.yml
